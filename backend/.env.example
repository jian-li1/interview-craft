APP_ENV=development                  # development | production
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
SESSION_JWT_SECRET=changeme-generate-a-random-64-hex-string   # REQUIRED
SESSION_JWT_EXPIRES_MIN=10080        # 7 days
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com   # REQUIRED

# Firestore: either emulator or service account
FIREBASE_PROJECT_ID=interview-blueprint-dev
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json   # omit when using emulator
FIRESTORE_EMULATOR_HOST=                                   # e.g. localhost:8686 for emulator

# LLM — OPENAI_MODEL/GEMINI_MODEL are comma-separated lists; the composer's model chip
# offers the union of both (Gemini models only when GEMINI_API_KEY is set below). The
# FIRST entry of OPENAI_MODEL is the server default — also used for one-shot server-side
# generations with no conversation (onboarding profile synthesis). Auto-compaction runs
# on whatever model the user has selected for that conversation.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o,gpt-4o-mini
OPENAI_BASE_URL=                     # any OpenAI-compatible endpoint, e.g. http://localhost:8080/v1 (blank = api.openai.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro,gemini-2.5-flash

# Search — the composer's search chip offers duckduckgo (always) plus google/tavily
# when their keys below are set; DuckDuckGo (keyless) is the fallback default.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=
TAVILY_API_KEY=

# Agent behavior
AGENT_MAX_ITERATIONS=60
CONTEXT_TOKEN_LIMIT=100000           # trigger compaction above ~80% of this

# LLM request shape / resilience
LLM_MAX_OUTPUT_TOKENS=8192           # hard cap on generated tokens per call (all providers)
LLM_REQUEST_TIMEOUT_SECONDS=300      # inter-chunk timeout for streaming; also applies to non-streaming calls; bump higher for reasoning models with long silent gaps between chunks
